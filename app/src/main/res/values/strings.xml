    <string name="lockdown_title">Internet toʻxtab qolishi mumkin</string>
    <string name="lockdown_text">Sozlamalarda “VPN’siz ulanishni bloklash” yoqilgan. Bu ilova bilan u internetni toʻxtatib qoʻyishi mumkin. Uni oʻchirib, faqat “Doim yoqiq VPN”ni qoldiring.</string>

    <string name="private_dns_title">Private DNS filtrga xalaqit beradi</string>

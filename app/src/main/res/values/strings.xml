    <string name="always_on_title">Himoyani mustahkamlang</string>
    <string name="always_on_text">Telefon sozlamalarida shu ilova uchun “Doim yoqiq VPN”ni yoqing. Shunda himoya telefon qayta yoqilganda ham oʻzi ishga tushadi.</string>
